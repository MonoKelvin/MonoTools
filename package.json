{
  "name": "monotools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MonoTools - 轻量级系统效率工具（启动项管理 + 全局搜索）",
  "author": "MonoKelvin",
  "scripts": {
    "dev": "tauri dev",
    "dev:no-watch": "tauri dev --no-watch",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint src/ --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate-icons.js",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin monotools-cli --",
    "cli:dev": "cargo run --manifest-path src-tauri/Cargo.toml --bin monotools-cli -- --help"
  },
  "dependencies": {
    "@primeuix/themes": "^1.0.0",
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-global-shortcut": "^2.0.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@vueuse/core": "^12.0.0",
    "lucide-vue-next": "^0.460.0",
    "pinia": "^2.2.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.2.0",
    "vue": "^3.5.0",
    "vue-router": "^4.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.13.0",
    "postcss": "^8.4.0",
    "prettier": "^3.3.0",
    "sass": "^1.80.0",
    "tailwindcss": "^3.4.0",
    "typescript": "~5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
