{
  "name": "monotools",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "MonoTools - 轻量级系统效率工具（全局搜索 + 自定义命令）",
  "author": "MonoKelvin",
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "dev:no-watch": "tauri dev --no-watch",
    "build": "tauri build",
    "build:debug": "tauri build --debug",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint src/ --ext .ts,.vue",
    "format": "prettier --write \"src/**/*.{ts,vue,scss}\"",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "icons": "node scripts/generate-icons.js",
    "cli": "cargo run --manifest-path src-tauri/Cargo.toml --bin monotools-cli --",
    "cli:dev": "cargo run --manifest-path src-tauri/Cargo.toml --bin monotools-cli -- --help"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.0",
    "@tauri-apps/api": "^2.11",
    "@tauri-apps/plugin-fs": "^2.5",
    "@tauri-apps/plugin-global-shortcut": "^2.3",
    "@tauri-apps/plugin-shell": "^2.3",
    "@vueuse/core": "^14.0",
    "@lucide/vue": "^1.23",
    "pinia": "^3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5",
    "vue": "^3.5",
    "vue-router": "^4.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11",
    "@tailwindcss/vite": "^4.0",
    "@types/node": "^22.0",
    "@vitejs/plugin-vue": "^6.0",
    "autoprefixer": "^10.4",
    "eslint": "^9.13",
    "postcss": "^8.4",
    "prettier": "^3.3",
    "sass": "^1.80",
    "tailwindcss": "^4.0",
    "typescript": "~5.7",
    "vite": "^6.0",
    "vitest": "^3.0"
  },
  "files": [
    "dist",
    "src-tauri"
  ]
}
