{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "MonoTools",
    "version": "1.1.0",
    "identifier": "com.monotools.app",
    "build": {
        "beforeDevCommand": "pnpm dev:frontend",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "pnpm build:frontend",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "search",
                "title": "MonoTools",
                "width": 600,
                "height": 500,
                "minWidth": 520,
                "minHeight": 280,
                "decorations": false,
                "alwaysOnTop": true,
                "skipTaskbar": true,
                "transparent": true,
                "resizable": false,
                "visible": false,
                "center": true,
                "shadow": true,
                "backgroundColor": "#15151a"
            }
        ],
        "security": {
            "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "category": "Productivity",
        "shortDescription": "Lightweight system launcher and global search",
        "longDescription": "MonoTools is a lightweight system productivity tool focused on global search and custom commands.",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "windows": {
            "wix": {
                "language": [
                    "zh-CN",
                    "en-US"
                ]
            },
            "nsis": {
                "languages": [
                    "SimpChinese",
                    "English"
                ]
            }
        }
    },
    "plugins": {}
}
